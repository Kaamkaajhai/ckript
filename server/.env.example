PORT=5001
MONGO_URI=mongodb+srv://username:passward@cluster0.x9mv4pb.mongodb.net/scriptbridge
JWT_SECRET=your_jwt_secret_key_here_change_in_production
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://ckript.com,https://www.ckript.com,http://ckript.com,http://www.ckript.com
OTP_EXPIRY_SECONDS=60
OTP_RESEND_COOLDOWN_SECONDS= 2
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GOOGLE_AI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# Google Calendar OAuth (producer meeting scheduling). Uses the same OAuth client as sign-in above,
# but the classic auth-code flow needs the client SECRET and a registered redirect URI. In Google Cloud
# Console: enable the Calendar API, add scope https://www.googleapis.com/auth/calendar.events, and add
# GOOGLE_CALENDAR_REDIRECT_URI (below) as an Authorized redirect URI on the OAuth client — VERBATIM.
# Register BOTH of these on the OAuth client so dev and prod both work:
#   http://localhost:5002/api/google-calendar/callback                        (local dev)
#   https://server-sooty-rho.vercel.app/api/google-calendar/callback          (production backend)
# The redirect URI must point at the BACKEND host (Vercel), not the ckript.com front-end.
# Then set this var per-environment to the one that matches that deployment:
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5002/api/google-calendar/callback
# 64 hex chars (32 bytes) — encrypts Google refresh tokens at rest. Generate: openssl rand -hex 32
TOKEN_ENC_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dedicated HMAC secret for short-lived file attachment grants. If omitted, JWT_SECRET is used.
FILE_UPLOAD_GRANT_SECRET=
# Optional comma-separated exact HTTPS delivery hosts in addition to res.cloudinary.com.
TRUSTED_MEDIA_HOSTS=
EMAIL_USER=info.ckript@gmail.com
EMAIL_PASSWORD=
ADMIN_RUNTIME_BRANCH=
ADMIN_ALLOWED_BRANCHES=
IP_API_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
GROQ_API_KEY=
